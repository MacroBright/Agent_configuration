{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "{{HOME}}/.agent-memory/knowledge-graph.jsonl"
      }
    },
    "github-mcp-server": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server"]
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "obsidian-mcp"]
    },
    "arxiv": {
      "command": "npx",
      "args": ["-y", "arxiv-mcp-server"]
    },
    "huggingface": {
      "command": "npx",
      "args": ["-y", "huggingface-mcp-server"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode"]
    }
  }
}
